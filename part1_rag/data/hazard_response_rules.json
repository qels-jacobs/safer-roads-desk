{
  "document": "Safer Roads Desk - Hazard Response Rules v1.0 (synthetic)",
  "risk_score": {
    "formula": "severity x speed_factor x pedestrian_factor x hotspot_factor x report_factor",
    "speed_factor": "speed_limit_kmh / 60",
    "pedestrian_factor": {
      "High": 1.5,
      "Medium": 1.2,
      "Low": 1.0
    },
    "hotspot_factor": "1 + (fatal x 0.2 + serious x 0.05) at the matched hotspot, capped at 3.0; 1.0 if no hotspot",
    "report_factor": "1 + 0.1 x (number of independent reports - 1), capped at 1.5",
    "priority_bands": {
      "P1 - Urgent": ">= 12 (inspect within 4 hours)",
      "P2 - High": "6 to < 12 (within the hazard deadline, max 48 h)",
      "P3 - Routine": "< 6 (within the hazard deadline)"
    },
    "overrides": [
      "traffic_signal_outage at any hotspot is always P1",
      "Hazards on national roads (N1, N2) are referred to SANRAL, not scheduled"
    ]
  },
  "hazard_types": [
